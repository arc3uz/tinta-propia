{
  "name": "tinta-propia",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "description": "Tinta Propia: editor local de manuscritos con tu letra, interfaz tipo Overleaf.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arc3uz/tinta-propia.git"
  },
  "homepage": "https://github.com/arc3uz/tinta-propia",
  "bugs": {
    "url": "https://github.com/arc3uz/tinta-propia/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 1421 --strictPort",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "version:bump": "node scripts/bump-version.mjs",
    "check": "npm run build && npm run test:rust"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.19.0",
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "codemirror": "^6.0.2",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "vite": "^8.3.8"
  }
}
