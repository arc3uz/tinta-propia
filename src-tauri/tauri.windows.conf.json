{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis", "msi"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  }
}
