{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tinta Propia",
  "version": "0.2.0",
  "identifier": "io.github.arc3uz.tintapropia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tinta Propia",
        "width": 1480,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "backgroundColor": "#eef1f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Manuscritos con tu propia letra",
    "longDescription": "Editor local de manuscritos con letra calibrada, fórmulas LaTeX, mezcla de fuentes, tres columnas, diagramas Mermaid y exportación a PDF.",
    "copyright": "Tinta Propia"
  }
}
